DATABASE_URL=postgres://revista:revista@localhost:5437/revista
APP_ORIGIN=http://localhost:3020
# Somente desenvolvimento: usuario falso. NUNCA ligar em producao.
DEV_FAKE_USER=1

# Cofre (central de identidade). Servidor a servidor; o segredo nunca vai ao navegador.
COFRE_URL=http://localhost:3002
APP_SECRET_REVISTA=

# E-mails (separados por virgula) que viram admin ao entrar
ADMIN_EMAILS=

# v1 publica e sem dinheiro. 1 = liga marketplace, apoio, rodadas e conteudo pago (so apos parecer juridico + PSP)
FEATURE_MONEY=0

# Pagamentos (Asaas). Sandbox por padrao; producao exige ASAAS_ENV=production E FEATURE_MONEY=1.
ASAAS_ENV=sandbox
ASAAS_API_KEY=
# Token definido no painel do Asaas (Webhooks) e repetido aqui
ASAAS_WEBHOOK_TOKEN=
# Em dev, aponte para o Asaas falso (npm run mock:asaas). So vale em sandbox.
# ASAAS_BASE_URL=http://localhost:4010

# Comissao da plataforma sobre cada venda (0 a 50). Padrao 10.
COMMISSION_PERCENT=10

# Textos legais: dados da empresa (preencher antes de publicar) e fim do aviso de minuta.
LEGAL_COMPANY_NAME=
LEGAL_COMPANY_CNPJ=
LEGAL_COMPANY_ADDRESS=
LEGAL_CONTACT_EMAIL=
LEGAL_PRIVACY_EMAIL=
LEGAL_FORUM=
# 0 = tira o aviso de minuta (so depois do parecer juridico)
LEGAL_DRAFT=1
